    "grid": {
      "stroke": "#e1e5e8",
      "showVerticalLines": false,
      "showHorizontalLines": false,
      "position": "middle",
      "frame": {
        "show": false,
        "stroke": "#e1e5e8",
        "strokeWidth": 2,
        "strokeLinecap": "round",
        "strokeLinejoin": "round",
        "strokeDasharray": 0
      },
      "labels": {
        "show": true,
        "color": "#2D353C",
